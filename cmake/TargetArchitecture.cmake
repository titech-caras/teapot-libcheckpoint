if(CHECKPOINT_ARCH)
    set(CHECKPOINT_PROCESSOR_SOURCE "${CHECKPOINT_ARCH}")
elseif(CMAKE_C_COMPILER_TARGET)
    set(CHECKPOINT_PROCESSOR_SOURCE "${CMAKE_C_COMPILER_TARGET}")
elseif(CMAKE_C_COMPILER MATCHES "(^|/)(aarch64|arm64)-")
    set(CHECKPOINT_PROCESSOR_SOURCE "aarch64")
elseif(CMAKE_C_COMPILER MATCHES "(^|/)riscv64-")
    set(CHECKPOINT_PROCESSOR_SOURCE "riscv64")
else()
    set(CHECKPOINT_PROCESSOR_SOURCE "${CMAKE_SYSTEM_PROCESSOR}")
endif()

string(TOLOWER "${CHECKPOINT_PROCESSOR_SOURCE}" CHECKPOINT_SYSTEM_PROCESSOR)
if(CHECKPOINT_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64)(-|$)")
    set(CHECKPOINT_ARCH_NAME "x64")
    set(CHECKPOINT_ASM_SOURCE asm/checkpoint_x64.S)
elseif(CHECKPOINT_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)(-|$)")
    set(CHECKPOINT_ARCH_NAME "aarch64")
    set(CHECKPOINT_ASM_SOURCE asm/checkpoint_aarch64.S)
elseif(CHECKPOINT_SYSTEM_PROCESSOR MATCHES "^(riscv64)(-|$)")
    set(CHECKPOINT_ARCH_NAME "riscv64")
    set(CHECKPOINT_ASM_SOURCE asm/checkpoint_riscv64.S)
else()
    message(FATAL_ERROR "Unsupported libcheckpoint architecture: ${CHECKPOINT_PROCESSOR_SOURCE}")
endif()
